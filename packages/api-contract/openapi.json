        "tags": [
          "forecast"
        ]
      }
    },
    "/v1/point": {
      "get": {
        "description": "Rainfall per frame (3-hourly to 24-hourly, depending on tier and lead time) at a\nlocation, bilinearly interpolated from the finest published grid that covers it.",
        "operationId": "point_v1_point_get",
        "parameters": [
          {
            "description": "Latitude, degrees north.",
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "description": "Latitude, degrees north.",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "description": "Longitude, degrees east.",
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "description": "Longitude, degrees east.",
              "maximum": 360,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          },
          {
            "description": "Source id, e.g. ecmwf-ifs.",
            "in": "query",
            "name": "source",
            "required": false,
            "schema": {
              "default": "ecmwf-ifs",
              "description": "Source id, e.g. ecmwf-ifs.",
              "title": "Source",
              "type": "string"
            }
          },
          {
            "description": "Run id; default latest.",
            "in": "query",
            "name": "run",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^\\d{10}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Run id; default latest.",
              "title": "Run"
            }
          },
          {
            "description": "Force a tier; default the finest covering the point.",
            "in": "query",
            "name": "tier",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Force a tier; default the finest covering the point.",
              "title": "Tier"
            }
