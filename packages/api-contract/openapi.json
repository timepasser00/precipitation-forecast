  "info": {
    "description": "\nRead-only API over processed ECMWF open-data precipitation forecasts.\n\n**How it fits together.** A pipeline publishes immutable run data (map tiles and point cubes)\nplus a small `manifest.json` to object storage. Map clients read the manifest and fetch tiles\nstraight from the CDN; this API answers the questions a browser should not have to compute:\npoint forecasts and cross-source comparisons.\n\n**Caching.** Responses for a pinned `run` are immutable and cached for a year. Responses that\nfollow `latest` are cached for 60 seconds.\n\n**Units and time.** Rainfall is in millimetres over each frame's `[start, end)` window.\nAll timestamps are UTC (ISO 8601).\n",
    "title": "Precipitation Forecast API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/data/{path}": {
      "get": {
        "operationId": "data_data__path__get",
        "parameters": [
          {
            "in": "path",
            "name": "path",
            "required": true,
            "schema": {
              "title": "Path",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Raw object (dev only)",
        "tags": [
          "data"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness and data check",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/compare": {
      "get": {
        "description": "Latest run of each source at one location. A source that fails is reported in\n`errors` and does not hide the others.\n\nSources keep their own run time and frame widths, so results are **not** aligned: compare\nby each frame's `start`/`end`, not by index, and do not compare `totals_mm` horizons\nacross sources with different `run_time`.",
        "operationId": "compare_v1_compare_get",
        "parameters": [
          {
            "description": "Latitude, degrees north.",
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "description": "Latitude, degrees north.",
              "maximum": 90,
              "minimum": -90,
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "description": "Longitude, degrees east.",
            "in": "query",
            "name": "lon",
            "required": true,
            "schema": {
              "description": "Longitude, degrees east.",
              "maximum": 360,
              "minimum": -180,
              "title": "Lon",
              "type": "number"
            }
          },
          {
            "description": "Comma-separated source ids; default all published.",
            "in": "query",
            "name": "sources",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Comma-separated source ids; default all published.",
              "title": "Sources"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Comparison"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Same location, several sources",
        "tags": [
          "forecast"
        ]
      }
    },
    "/v1/config": {
      "get": {
        "operationId": "client_config_v1_config_get",
        "responses": {
          "200": {
